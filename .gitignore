# Data — never commit raw or processed signals
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results caches (keep figures/tables you explicitly add)
results/figures/cache/
results/tables/*.csv

# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
dist/
*.egg

# Environments
.venv/
venv/
.env

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/
.coverage
htmlcov/
